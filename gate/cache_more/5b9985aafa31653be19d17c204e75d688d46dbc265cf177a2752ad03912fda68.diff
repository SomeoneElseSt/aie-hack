+        let expiry = chrono::Utc::now() + chrono::Duration::hours(1);
+        let a = FederatedAssertion::new(SecretString::new("tok"), "issuer").with_expires_at(expiry);
+        assert_eq!(AuthScheme::expires_at(&a), Some(expiry));
+    }
+}
